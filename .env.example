# Nabha Healthcare Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Configuration
VITE_APP_TITLE=Nabha Healthcare
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Modern healthcare platform for rural communities

# API Configuration
VITE_API_URL=http://localhost:3001/api

# Payment Gateway Configuration (Razorpay)
# Get these from https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_5KDLZcQOeZLk8K
VITE_RAZORPAY_KEY_SECRET=iup6OxBjjs22NfyIV2vN4x8p
VITE_RAZORPAY_MONTHLY_PLAN_ID=plan_Qq8H89m2adcMl6
VITE_RAZORPAY_YEARLY_PLAN_ID=plan_Qq8Hl09aOS9uAg
VITE_RAZORPAY_WEBHOOK_SECRET=69f8825c-ae86-4a76-89d5-501a621e772e
VITE_PAYMENT_API_URL=http://localhost:3001/api/payments

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=373702281069-uu025bq20lpq6eivio8h2674up6g57uj.apps.googleusercontent.com

# Server Configuration
VITE_SERVER_ENDPOINT=http://localhost:5001
VITE_API_TIMEOUT=10000

# Google Gemini AI Configuration (Required for chatbot)
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# WebRTC Configuration (Required for video calls)
VITE_WEBRTC_ICE_SERVERS=["stun:stun.l.google.com:19302"]

# WhatsApp Business API (Optional)
VITE_WHATSAPP_BUSINESS_ID=your_whatsapp_business_id

# Development Configuration
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug

# Healthcare Specific Configuration
VITE_HEALTH_RECORDS_ENCRYPTION=true
VITE_PATIENT_DATA_RETENTION_DAYS=2555  # 7 years as per healthcare standards

# Security Configuration
VITE_SESSION_TIMEOUT=3600000  # 1 hour in milliseconds
VITE_MAX_LOGIN_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_AI_CHATBOT=true
VITE_ENABLE_PHARMACY_INTEGRATION=true
VITE_ENABLE_SYMPTOM_CHECKER=true
VITE_ENABLE_HEALTH_RECORDS=true

# Analytics (Optional)
VITE_ANALYTICS_ID=your_analytics_id
VITE_ENABLE_ANALYTICS=false

# Notification Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,hi,pa

# Payment Gateway (Future implementation)
VITE_PAYMENT_GATEWAY_URL=https://api.payment-provider.com
VITE_PAYMENT_PUBLIC_KEY=your_payment_public_key

# Error Tracking (Optional)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_ENABLE_ERROR_TRACKING=false